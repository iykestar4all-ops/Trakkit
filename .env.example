# Trackit backend configuration. Copy to .env and fill in as needed.
# (Nothing here is required for local development — the app runs in mock
#  billing mode until you add a Paystack secret key.)

# Port the server listens on (serves the app AND the API).
PORT=5050

# Paystack SECRET key (sk_test_… or sk_live_…). When set, "Subscribe"
# runs real card checkout on Paystack and payments are verified server-side.
# Leave blank for local dev (mock activation).
PAYSTACK_SECRET_KEY=

# Persistent storage (Supabase). With both set, all data lives in Supabase
# Postgres and survives restarts/redeploys — even on free hosting. Without
# them, the app uses a local JSON file (fine for development only).
# One-time setup in the Supabase SQL editor:
#   create table if not exists kv (k text primary key, v jsonb);
#   alter table kv enable row level security;
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...          (Project Settings -> API -> service_role key; keep secret)

# Local file location when NOT using Supabase (development). Defaults to server/data/.
# TRACKIT_DATA_DIR=/var/data/trackit

# Anthropic API key — turns the report "Insights" panel into real AI analysis.
# Without it, insights are generated by a built-in rule-based analyzer.
# ANTHROPIC_API_KEY=
# TRACKIT_AI_MODEL=claude-haiku-4-5-20251001
